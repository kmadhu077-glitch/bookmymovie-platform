# BookMyMovie Platform Environment Configuration

# Database Configuration
DATABASE_URL=postgresql://bookmymovie:SecurePass123!@localhost:5432/bookmymovie
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=bookmymovie
DATABASE_USER=bookmymovie
DATABASE_PASSWORD=SecurePass123!

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security Configuration
JWT_SECRET_KEY=your-super-secure-jwt-secret-key-change-this-in-production-256-bits-long
ENVIRONMENT=development

# Payment Configuration (Use test keys for development)
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_test_key_here

# Service Ports
AUTH_SERVICE_PORT=8013
CATALOG_SERVICE_PORT=8012
BOOKING_SERVICE_PORT=8014
PAYMENT_SERVICE_PORT=8015
REALTIME_SERVICE_PORT=8016
FRONTEND_PORT=8080

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Performance Configuration
CACHE_TTL=300
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Security Settings
CORS_ORIGINS=["http://localhost:8080", "http://127.0.0.1:8080"]
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60