# Development Environment Configuration
# This file contains non-sensitive configuration for local development

# Use SQLite for development (no PostgreSQL required)
DATABASE_URL=sqlite:///./bookmymovie_dev.db
DATABASE_TYPE=sqlite

# Use in-memory Redis alternative for development
REDIS_URL=memory://localhost
USE_MEMORY_CACHE=true

# Development security (less secure but easier for testing)
JWT_SECRET_KEY=dev-jwt-secret-key-not-for-production
ENVIRONMENT=development

# Development payment (test mode)
STRIPE_SECRET_KEY=sk_test_development_key
PAYMENT_MODE=test

# Service configuration
AUTH_SERVICE_HOST=127.0.0.1
CATALOG_SERVICE_HOST=127.0.0.1
BOOKING_SERVICE_HOST=127.0.0.1
PAYMENT_SERVICE_HOST=127.0.0.1
REALTIME_SERVICE_HOST=127.0.0.1

# Development settings
DEBUG=true
RELOAD=true
LOG_LEVEL=DEBUG